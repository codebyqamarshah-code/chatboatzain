# Choose provider: gemini or groq
AI_PROVIDER=groq

# Groq (OpenAI-compatible streaming API). Create key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternatively Gemini. Key setup: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
